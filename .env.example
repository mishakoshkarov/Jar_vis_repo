# Обязательно: ключ Claude API (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Необязательно
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_EFFORT=low
# JARVIS_DEFAULT_SCENE=v5          # что отдавать по /scene: v4 или v5
# JARVIS_BIND_HOST=127.0.0.1       # 0.0.0.0 — открыть для пульта с телефона в локальной сети
# PORT=8321

# Голос Yandex SpeechKit (без ключей — системный голос macOS или голос браузера)
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_VOICE=zhanar_ru
# YANDEX_ROLE=friendly
